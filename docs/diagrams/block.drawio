  <diagram id="gYgsL-uo_jw2sPxm3gfg" name="Page-2">
    <mxGraphModel dx="10300" dy="6260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\nROOT[\&quot;VAJRAN v2.0 Industrial Robot Controller\&quot;]\n\nROOT --&gt; P1\nROOT --&gt; C1\nROOT --&gt; S4\n\nsubgraph PWR[\&quot;POWER AND PROTECTION\&quot;]\n  P1[\&quot;24V Input - Fuse, Reverse Polarity, EMI Filter\&quot;]\n  P2[\&quot;Surge, TVS, ESD, Inrush Limiter\&quot;]\n  P3[\&quot;Buck 5V and 3.3V, LDO 1.8V Analog\&quot;]\n  P4[\&quot;Hold-up Cap, Brownout Detect, PGOOD Sequencing\&quot;]\n  P5[\&quot;Isolated DC-DC for Field Side\&quot;]\n  P6[\&quot;VBAT Domain - Coin Cell or Supercap\&quot;]\n  P1 --&gt; P2\n  P2 --&gt; P3\n  P3 --&gt; P4\n  P2 --&gt; P5\nend\n\nsubgraph CORE[\&quot;PROCESSING CORE\&quot;]\n  C1[\&quot;STM32H7 MCU - Control Loops, Timers, PWM, ADC, DMA\&quot;]\n  C2[\&quot;External Windowed Watchdog\&quot;]\n  C3[\&quot;QSPI Flash - A/B OTA Slots\&quot;]\n  C4[\&quot;FRAM - Parameters and Fault Log\&quot;]\n  C5[\&quot;RTC and Secure Element\&quot;]\n  C6[\&quot;microSD Trace Logging\&quot;]\n  C1 --&gt; C2\n  C1 --&gt; C3\n  C1 --&gt; C4\n  C1 --&gt; C5\n  C1 --&gt; C6\nend\n\nsubgraph SAFE[\&quot;FUNCTIONAL SAFETY\&quot;]\n  S2[\&quot;E-Stop Loop Input Isolated\&quot;]\n  S4[\&quot;Safe State Logic Independent of MCU\&quot;]\n  S1[\&quot;Dual Channel STO - Safe Torque Off\&quot;]\n  S3[\&quot;Safety Relay and Mirror Contact Feedback\&quot;]\n  S2 --&gt; S4\n  S4 --&gt; S1\n  S4 --&gt; S3\nend\n\nsubgraph MOT[\&quot;MOTOR AND MOTION\&quot;]\n  M1[\&quot;PWM Outputs - 3 Phase or Step-Dir\&quot;]\n  M2[\&quot;Incremental Encoder x4 - A B Z\&quot;]\n  M3[\&quot;Absolute Encoder - BiSS-C, EnDat, SSI, Tamagawa\&quot;]\n  M4[\&quot;Hall Inputs, Resolver, SinCos\&quot;]\n  M5[\&quot;Phase Current Sense - Shunt and Isolated Amp\&quot;]\n  M6[\&quot;24V Brake Driver with Diagnostics\&quot;]\nend\n\nsubgraph COMM[\&quot;COMMUNICATION - ISOLATED\&quot;]\n  N1[\&quot;EtherCAT Slave LAN9252 - 2x RJ45 Daisy Chain\&quot;]\n  N2[\&quot;CAN-FD x2 Isolated\&quot;]\n  N3[\&quot;RS-485 Modbus Isolated\&quot;]\n  N4[\&quot;Gigabit Ethernet - TCP/IP or PROFINET\&quot;]\n  N5[\&quot;IO-Link Master for Tool or Gripper\&quot;]\n  N6[\&quot;USB-C - DFU and Debug VCP\&quot;]\n  N7[\&quot;SWD JTAG Header\&quot;]\nend\n\nsubgraph IO[\&quot;INDUSTRIAL I/O - ISOLATED\&quot;]\n  I1[\&quot;Digital IN - IEC 61131-2 Type 1 and 3\&quot;]\n  I2[\&quot;Digital OUT - Smart High Side Drivers\&quot;]\n  I3[\&quot;Analog IN - 16 bit Isolated ADC\&quot;]\n  I4[\&quot;Analog OUT - 0-10V and 4-20mA\&quot;]\nend\n\nsubgraph SENS[\&quot;SENSORS AND DIAGNOSTICS\&quot;]\n  D1[\&quot;6 Axis IMU\&quot;]\n  D2[\&quot;Bus and Phase Current Monitor\&quot;]\n  D3[\&quot;Rail Voltage Monitor\&quot;]\n  D4[\&quot;NTC x3 - Motor, Power Stage, Board\&quot;]\n  D5[\&quot;RGB Status LEDs and Buzzer\&quot;]\n  D6[\&quot;Node Address Rotary and DIP Switches\&quot;]\nend\n\nP3 --&gt; C1\nP5 --&gt; I1\nP5 --&gt; N2\nP6 --&gt; C5\nP4 --&gt; S4\n\nC1 --&gt; M1\nC1 --&gt; I1\nC1 --&gt; N1\nC1 --&gt; D1\n\nC2 --&gt; S4\nS1 --&gt; M1\nS1 --&gt; M6\nM2 --&gt; C1\nM3 --&gt; C1\nM4 --&gt; C1\nM5 --&gt; C1\nD4 --&gt; S4\n\nclassDef power fill:#FFE8CC,stroke:#D9822B,stroke-width:2px,color:#000000\nclassDef core fill:#D6E4FF,stroke:#2B579A,stroke-width:2px,color:#000000\nclassDef safety fill:#FFD6D6,stroke:#C0392B,stroke-width:2px,color:#000000\nclassDef motion fill:#DFF5E1,stroke:#2E8B57,stroke-width:2px,color:#000000\nclassDef comm fill:#E8DAFF,stroke:#6B3FA0,stroke-width:2px,color:#000000\nclassDef io fill:#FFF7CC,stroke:#B7950B,stroke-width:2px,color:#000000\nclassDef sensor fill:#D9F2F5,stroke:#1F7A8C,stroke-width:2px,color:#000000\nclassDef root fill:#2B579A,stroke:#1A3A6B,stroke-width:3px,color:#FFFFFF\n\nclass ROOT root\nclass P1,P2,P3,P4,P5,P6 power\nclass C1,C2,C3,C4,C5,C6 core\nclass S1,S2,S3,S4 safety\nclass M1,M2,M3,M4,M5,M6 motion\nclass N1,N2,N3,N4,N5,N6,N7 comm\nclass I1,I2,I3,I4 io\nclass D1,D2,D3,D4,D5,D6 sensor\n\nstyle PWR fill:#FFF6EC,stroke:#D9822B,stroke-width:2px\nstyle CORE fill:#F0F5FF,stroke:#2B579A,stroke-width:2px\nstyle SAFE fill:#FFF0F0,stroke:#C0392B,stroke-width:2px\nstyle MOT fill:#F2FBF4,stroke:#2E8B57,stroke-width:2px\nstyle COMM fill:#F7F2FF,stroke:#6B3FA0,stroke-width:2px\nstyle IO fill:#FFFDF0,stroke:#B7950B,stroke-width:2px\nstyle SENS fill:#F0FAFC,stroke:#1F7A8C,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Y77NqwOLfAgQSu4OJL-e-1">
