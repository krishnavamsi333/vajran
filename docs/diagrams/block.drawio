  <diagram id="ULPO0SAey974w4mVD_pP" name="Page-3">
    <mxGraphModel dx="2575" dy="1565" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    %% =========================\n    %% VAJRAN SYSTEM\n    %% =========================\n\n    SYS[\&quot;VAJRAN v1.0&lt;br/&gt;Industrial Robotics Controller\&quot;]\n\n    %% =========================\n    %% POWER\n    %% =========================\n\n    PWR[\&quot;24V DC POWER INPUT\&quot;]\n\n    PROT[\&quot;POWER PROTECTION&lt;br/&gt;Fuse / eFuse&lt;br/&gt;Reverse Polarity&lt;br/&gt;TVS / Surge\&quot;]\n\n    REG[\&quot;POWER MANAGEMENT&lt;br/&gt;24V → 12V&lt;br/&gt;24V → 5V&lt;br/&gt;5V → 3.3V\&quot;]\n\n    MON[\&quot;POWER MONITORING&lt;br/&gt;Input Voltage&lt;br/&gt;Logic Voltage&lt;br/&gt;Current\&quot;]\n\n    PWR --&gt; PROT\n    PROT --&gt; REG\n    REG --&gt; MON\n\n    %% =========================\n    %% MCU\n    %% =========================\n\n    MCU[\&quot;STM32 MCU&lt;br/&gt;Main Controller\&quot;]\n\n    CLK[\&quot;CLOCK&lt;br/&gt;Crystal / Oscillator\&quot;]\n    RST[\&quot;RESET / WATCHDOG\&quot;]\n    DBG[\&quot;SWD DEBUG&lt;br/&gt;SWDIO / SWCLK\&quot;]\n\n    REG --&gt; MCU\n    CLK --&gt; MCU\n    RST --&gt; MCU\n    DBG --&gt; MCU\n\n    %% =========================\n    %% COMMUNICATION\n    %% =========================\n\n    subgraph COMM[\&quot;COMMUNICATION\&quot;]\n        CAN1[\&quot;CAN-FD #1&lt;br/&gt;Transceiver + Protection\&quot;]\n        CAN2[\&quot;CAN-FD #2&lt;br/&gt;Transceiver + Protection\&quot;]\n        ETH[\&quot;Ethernet 10/100&lt;br/&gt;PHY + Magnetics + RJ45\&quot;]\n        RS[\&quot;RS-485&lt;br/&gt;Transceiver + Protection\&quot;]\n        USB[\&quot;USB-C&lt;br/&gt;USB 2.0 + ESD\&quot;]\n    end\n\n    MCU --&gt; CAN1\n    MCU --&gt; CAN2\n    MCU --&gt; ETH\n    MCU --&gt; RS\n    MCU --&gt; USB\n\n    %% =========================\n    %% MOTION\n    %% =========================\n\n    subgraph MOTION[\&quot;MOTION / MOTOR INTERFACE\&quot;]\n        ENC1[\&quot;Encoder #1&lt;br/&gt;A / B / Z\&quot;]\n        ENC2[\&quot;Encoder #2&lt;br/&gt;A / B / Z\&quot;]\n        ENC3[\&quot;Encoder #3&lt;br/&gt;A / B / Z\&quot;]\n        ENC4[\&quot;Encoder #4&lt;br/&gt;A / B / Z\&quot;]\n\n        PWM[\&quot;Motor Control Signals&lt;br/&gt;PWM / DIR / ENABLE\&quot;]\n    end\n\n    MCU --&gt; ENC1\n    MCU --&gt; ENC2\n    MCU --&gt; ENC3\n    MCU --&gt; ENC4\n    MCU --&gt; PWM\n\n    %% =========================\n    %% INDUSTRIAL IO\n    %% =========================\n\n    subgraph IO[\&quot;INDUSTRIAL I/O\&quot;]\n        DIN[\&quot;Digital Inputs&lt;br/&gt;24V Protected\&quot;]\n        DOUT[\&quot;Digital Outputs&lt;br/&gt;Protected MOSFET\&quot;]\n        AIN[\&quot;Analog Inputs&lt;br/&gt;0–10V / ADC\&quot;]\n    end\n\n    MCU --&gt; DIN\n    MCU --&gt; DOUT\n    MCU --&gt; AIN\n\n    %% =========================\n    %% SENSORS\n    %% =========================\n\n    subgraph SENSORS[\&quot;SENSORS\&quot;]\n        IMU[\&quot;6-Axis IMU&lt;br/&gt;Accelerometer + Gyroscope\&quot;]\n        TEMP[\&quot;Temperature Sensors\&quot;]\n        CURR[\&quot;Current Sensors\&quot;]\n        VOLT[\&quot;Voltage Sensing\&quot;]\n    end\n\n    MCU --&gt; IMU\n    MCU --&gt; TEMP\n    MCU --&gt; CURR\n    MCU --&gt; VOLT\n\n    %% =========================\n    %% MEMORY\n    %% =========================\n\n    subgraph MEM[\&quot;MEMORY / STORAGE\&quot;]\n        FLASH[\&quot;External SPI Flash\&quot;]\n        EEPROM[\&quot;I²C EEPROM\&quot;]\n        SD[\&quot;microSD&lt;br/&gt;Data Logging\&quot;]\n    end\n\n    MCU --&gt; FLASH\n    MCU --&gt; EEPROM\n    MCU --&gt; SD\n\n    %% =========================\n    %% USER INTERFACE\n    %% =========================\n\n    subgraph UI[\&quot;USER INTERFACE\&quot;]\n        LED[\&quot;Status LEDs\&quot;]\n        BTN[\&quot;User Buttons\&quot;]\n        DISP[\&quot;Display / Expansion Header\&quot;]\n    end\n\n    MCU --&gt; LED\n    BTN --&gt; MCU\n    MCU --&gt; DISP\n\n    %% =========================\n    %% EXTERNAL SYSTEM\n    %% =========================\n\n    ROBOT[\&quot;ROBOT / INDUSTRIAL SYSTEM\&quot;]\n\n    CAN1 &lt;--&gt; ROBOT\n    CAN2 &lt;--&gt; ROBOT\n    ETH &lt;--&gt; ROBOT\n    RS &lt;--&gt; ROBOT\n\n    ENC1 &lt;--&gt; ROBOT\n    ENC2 &lt;--&gt; ROBOT\n    ENC3 &lt;--&gt; ROBOT\n    ENC4 &lt;--&gt; ROBOT\n\n    PWM &lt;--&gt; ROBOT\n    DIN &lt;--&gt; ROBOT\n    DOUT &lt;--&gt; ROBOT\n    AIN &lt;--&gt; ROBOT\n\n    %% =========================\n    %% SYSTEM CONNECTION\n    %% =========================\n\n    SYS --&gt; PWR\n    SYS --&gt; MCU&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="x_F40texTMDNARG5yHlT-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="COMMUNICATION" mermaidId="n:COMM" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="COMMUNICATION" id="x_F40texTMDNARG5yHlT-2">
