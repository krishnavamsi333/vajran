        <mxCell id="ov_e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;startArrow=classic;startFill=1;" edge="1" parent="1" source="ov_comm" target="ov_robot"><mxGeometry relative="1" as="geometry"/></mxCell>
