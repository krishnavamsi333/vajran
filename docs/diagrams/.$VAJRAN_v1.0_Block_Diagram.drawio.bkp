        <object label="5 · INDUSTRIAL I/O&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;24V DIN · MOSFET DOUT&lt;br&gt;0–10V Analog IN&lt;/font&gt;" link="data:page/id,io" id="ov_io">
