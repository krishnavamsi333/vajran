        <mxCell id="ov_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="ov_mcu" target="ov_sens"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ov_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;" edge="1" parent="1" source="ov_mcu" target="ov_mem"><mxGeometry relative="1" as="geometry"/></mxCell>
