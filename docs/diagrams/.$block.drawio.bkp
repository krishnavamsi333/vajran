        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\nROOT[\&quot;VAJRAN v2.0 Industrial Robot Controller\&quot;]\n\nROOT --&gt; PWR\nROOT --&gt; CORE\nROOT --&gt; SAFE\n\nsubgraph PWR[\&quot;POWER AND PROTECTION\&quot;]\n  P1[\&quot;24V Input - Fuse, Reverse Polarity, EMI Filter\&quot;]\n  P2[\&quot;Surge, TVS, ESD, Inrush Limiter\&quot;]\n  P3[\&quot;Buck 5V and 3.3V, LDO 1.8V Analog\&quot;]\n  P4[\&quot;Hold-up Cap, Brownout Detect, PGOOD Sequencing\&quot;]\n  P5[\&quot;Isolated DC-DC for Field Side\&quot;]\n  P6[\&quot;VBAT Domain - Coin Cell or Supercap\&quot;]\n  P1 --&gt; P2\n  P2 --&gt; P3\n  P3 --&gt; P4\n  P2 --&gt; P5\nend\n\nsubgraph CORE[\&quot;PROCESSING CORE\&quot;]\n  C1[\&quot;STM32H7 MCU - Control Loops, Timers, PWM, ADC, DMA\&quot;]\n  C2[\&quot;External Windowed Watchdog\&quot;]\n  C3[\&quot;QSPI Flash - A/B OTA Slots\&quot;]\n  C4[\&quot;FRAM - Parameters and Fault Log\&quot;]\n  C5[\&quot;RTC and Secure Element\&quot;]\n  C6[\&quot;microSD Trace Logging\&quot;]\n  C1 --- C2\n  C1 --- C3\n  C1 --- C4\n  C1 --- C5\n  C1 --- C6\nend\n\nsubgraph SAFE[\&quot;FUNCTIONAL SAFETY\&quot;]\n  S1[\&quot;Dual Channel STO - Safe Torque Off\&quot;]\n  S2[\&quot;E-Stop Loop Input Isolated\&quot;]\n  S3[\&quot;Safety Relay and Mirror Contact Feedback\&quot;]\n  S4[\&quot;Safe State Logic Independent of MCU\&quot;]\n  S2 --&gt; S4\n  S4 --&gt; S1\n  S4 --&gt; S3\nend\n\nsubgraph MOT[\&quot;MOTOR AND MOTION\&quot;]\n  M1[\&quot;PWM Outputs - 3 Phase or Step-Dir\&quot;]\n  M2[\&quot;Incremental Encoder x4 - A B Z\&quot;]\n  M3[\&quot;Absolute Encoder - BiSS-C, EnDat, SSI, Tamagawa\&quot;]\n  M4[\&quot;Hall Inputs, Resolver, SinCos\&quot;]\n  M5[\&quot;Phase Current Sense - Shunt and Isolated Amp\&quot;]\n  M6[\&quot;24V Brake Driver with Diagnostics\&quot;]\nend\n\nsubgraph COMM[\&quot;COMMUNICATION - ISOLATED\&quot;]\n  N1[\&quot;EtherCAT Slave LAN9252 - 2x RJ45 Daisy Chain\&quot;]\n  N2[\&quot;CAN-FD x2 Isolated\&quot;]\n  N3[\&quot;RS-485 Modbus Isolated\&quot;]\n  N4[\&quot;Gigabit Ethernet - TCP/IP or PROFINET\&quot;]\n  N5[\&quot;IO-Link Master for Tool or Gripper\&quot;]\n  N6[\&quot;USB-C - DFU and Debug VCP\&quot;]\n  N7[\&quot;SWD JTAG Header\&quot;]\nend\n\nsubgraph IO[\&quot;INDUSTRIAL I/O - ISOLATED\&quot;]\n  I1[\&quot;Digital IN - IEC 61131-2 Type 1 and 3\&quot;]\n  I2[\&quot;Digital OUT - Smart High Side Drivers with Diagnostics\&quot;]\n  I3[\&quot;Analog IN - 16 bit Isolated ADC\&quot;]\n  I4[\&quot;Analog OUT - 0-10V and 4-20mA\&quot;]\nend\n\nsubgraph SENS[\&quot;SENSORS AND DIAGNOSTICS\&quot;]\n  D1[\&quot;6 Axis IMU\&quot;]\n  D2[\&quot;Bus and Phase Current Monitor\&quot;]\n  D3[\&quot;Rail Voltage Monitor\&quot;]\n  D4[\&quot;NTC x3 - Motor, Power Stage, Board\&quot;]\n  D5[\&quot;RGB Status LEDs and Buzzer\&quot;]\n  D6[\&quot;Node Address Rotary and DIP Switches\&quot;]\nend\n\nPWR --&gt; CORE\nP5 --&gt; IO\nP5 --&gt; COMM\nP6 --&gt; C5\nP4 --&gt; S4\n\nCORE --&gt; MOT\nCORE --&gt; IO\nCORE --&gt; COMM\nCORE --&gt; SENS\n\nC2 --&gt; S4\nS1 --&gt; M1\nS1 --&gt; M6\nM2 --&gt; C1\nM3 --&gt; C1\nM4 --&gt; C1\nM5 --&gt; C1\nD4 --&gt; S4&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="60T5n1M_eo9L3k3orOrP-1">
